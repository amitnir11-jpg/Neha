model Scan {
  id                   String    @id @default(cuid())
  data                 Json      @default("{}")
  dealerCode           String?
  auditId              String?
  partNumber           String?
  normalizedPartNumber String?
  uniqueScanId         String?
  scanId               String?
  globalUpiKey         String?
  upiCode              String?
  qrFingerprint        String?
  upiNo                String?
  rawUpiHash           String?
  bin                  String?
  binLocation          String?
  scanType             String?
  movementType         String?
  type                 String?
  syncStatus           String?
  scanStatus           String?
  status               String?
  source               String?
  userId               String?
  loginId              String?
  username             String?
  email                String?
  deviceId             String?
  key                  String?
  reportName           String?
  currentAuditId       String?
  timestamp            DateTime?
  scanTime             DateTime?
  time                 DateTime?
  dateTime             DateTime?
  activeInventory      Boolean?  @default(false)
  remainingQty         Float?    @default(0)
  deletedAt            DateTime?
  isDeleted            Boolean   @default(false)
  deletedBy            String?
  deletedByUsername    String?
  deletedByName        String?
  deletedByRole        String?
  deleteReason         String?
  preDeleteStatus      String?
  preDeleteScanStatus  String?
  preDeleteSyncStatus  String?
  lastModifiedBy       String?
  lastModifiedByUsername String?
  lastModifiedByName   String?
  lastModifiedByRole   String?
  lastModifiedAt       DateTime?
  createdBy            String?
  createdByUsername    String?
  createdByName        String?
  createdByRole        String?
  restoredAt           DateTime?
  restoredBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([dealerCode])
  @@index([auditId])
  @@index([partNumber])
  @@index([normalizedPartNumber])
  @@index([upiNo])
  @@index([upiCode])
  @@index([binLocation])
  @@index([scanType])
  @@index([scanStatus])
  @@index([status])
  @@index([createdAt])
  @@index([dealerCode, partNumber])
  @@index([dealerCode, scanType, createdAt])
  @@index([dealerCode, scanStatus, createdAt])
  @@index([dealerCode, auditId, upiCode])
  @@index([dealerCode, auditId, movementType])
  @@index([dealerCode, auditId, activeInventory])
  @@index([dealerCode, auditId, partNumber, binLocation])
  @@index([activeInventory])
  @@index([deletedAt])
  @@index([isDeleted])
  @@map("scans")
}

