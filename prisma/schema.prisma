  userId               String?
  loginId              String?
  username             String?
  email                String?
  deviceId             String?
  key                  String?
  reportName           String?
  currentAuditId       String?
  timestamp            DateTime?
  scanTime             DateTime?
  time                 DateTime?
  dateTime             DateTime?
  activeInventory      Boolean?  @default(false)
  remainingQty         Float?    @default(0)
  deletedAt            DateTime?
  isDeleted            Boolean   @default(false)
  deletedBy            String?
  deletedByUsername    String?
  deletedByName        String?
  deletedByRole        String?
  deleteReason         String?
  preDeleteStatus      String?
  preDeleteScanStatus  String?
  preDeleteSyncStatus  String?
  lastModifiedBy       String?
  lastModifiedByUsername String?
  lastModifiedByName   String?
  lastModifiedByRole   String?
  lastModifiedAt       DateTime?
  createdBy            String?
  createdByUsername    String?
  createdByName        String?
  createdByRole        String?
  restoredAt           DateTime?
  restoredBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([dealerCode])
  @@index([auditId])
  @@index([partNumber])
  @@index([normalizedPartNumber])
  @@index([upiNo])
  @@index([upiCode])
  @@index([binLocation])
  @@index([createdAt])
  @@index([dealerCode, auditId, timestamp])
  @@index([dealerCode, auditId, normalizedPartNumber])
  @@index([dealerCode, auditId, scanType, timestamp])
  @@index([dealerCode, partNumber])
  @@index([dealerCode, upiNo])
  @@index([dealerCode, auditId, upiCode])
  @@index([dealerCode, auditId, movementType])
  @@index([dealerCode, auditId, activeInventory])
  @@index([dealerCode, auditId, partNumber, binLocation])
  @@index([dealerCode, binLocation])
  @@index([activeInventory])
  @@index([dealerCode, scanStatus, createdAt])
  @@index([deletedAt])
  @@index([isDeleted])
  @@index([syncStatus])
  @@index([scanStatus])
  @@index([globalUpiKey])
  @@index([qrFingerprint])
  @@index([uniqueScanId])
  @@index([scanId])
  @@map("inventories")
}

