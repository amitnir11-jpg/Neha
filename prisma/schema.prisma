model Inventory {
  id                   String    @id @default(cuid())
  data                 Json      @default("{}")
  dealerCode           String?
  auditId              String?
  partNumber           String?
  normalizedPartNumber String?
  uniqueScanId         String?
  scanId               String?
  globalUpiKey         String?
  upiCode              String?
  qrFingerprint        String?
  upiNo                String?
  rawUpiHash           String?
  bin                  String?
  binLocation          String?
  scanType             String?
  movementType         String?
