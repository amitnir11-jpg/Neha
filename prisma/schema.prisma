// These models are used only by the separate license-server process. They are
// kept in the shared Prisma schema so the central service can use the same
// PostgreSQL deployment tooling without adding a second database technology.
// The customer application never writes these tables.
model LicenseRecord {
  id             String   @id @default(cuid())
  customerId     String?
  licenseKeyHash String   @unique
  status         String   @default("active")
  maxDevices     Int      @default(1)
  expiresAt      DateTime?
  features       Json     @default("{}")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@map("license_records")
}

model LicenseDevice {
  id                    String    @id @default(cuid())
  licenseId             String
  deviceFingerprintHash String
  devicePublicKey       String
  deviceName            String?
  status                String    @default("active")
  leaseId               String?
  activatedAt           DateTime  @default(now())
  lastSeenAt            DateTime  @default(now())
  lastIp                String?
  revokedAt             DateTime?
  releasedAt            DateTime?
  releaseReason         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([licenseId, deviceFingerprintHash])
  @@index([licenseId, status])
  @@index([deviceFingerprintHash])
  @@map("license_devices")
}

model LicenseActivationAudit {
  id        String   @id @default(cuid())
  licenseId String?
  deviceId  String?
  requestId String   @unique
  eventType String
  success   Boolean
  reason    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
  @@index([deviceId, createdAt])
  @@index([eventType, createdAt])
  @@map("license_activation_audits")
}

model LicenseAdminAudit {
  id          String   @id @default(cuid())
  adminSubject String
  action      String
  licenseId   String?
  deviceId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([licenseId, createdAt])
  @@index([adminSubject, createdAt])
  @@map("license_admin_audits")
}
