{
  "name": "daksh-inventory-v2",
  "version": "2.0.0",
  "description": "Advanced part inventory audit software with MongoDB, Socket.IO, Excel, PDF, email, backup, and device sync.",
  "main": "server.js",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "build": "npm run build:client && node scripts/build-check.js",
    "postinstall": "npm run build:client",
    "test": "node scripts/stock-valuation-check.js && node scripts/duplicate-upi-check.js",
    "test:catalogue-upload": "node scripts/catalogue-upload-check.js",
    "start": "node server.js"
  },
  "keywords": [
    "inventory",
    "audit",
    "mongodb",
    "socket.io",
    "exceljs",
    "jspdf"
  ],
  "author": "Daksh Inventory",
  "license": "MIT",
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "3.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "esbuild": "^0.28.1",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "xlsx": "^0.18.5"
  }
}
