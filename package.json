{
  "name": "daksh-inventory-v2",
  "version": "2.0.0",
  "description": "Advanced part inventory audit software with Railway PostgreSQL, Prisma, Socket.IO, Excel, PDF, email, backup, and device sync.",
  "main": "server.js",
  "scripts": {
    "build": "prisma generate && node scripts/build-check.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "start:api": "node server.js",
    "start:web": "node scripts/web-server.js",
    "test": "node scripts/master-price-logic-check.js && node scripts/stock-valuation-check.js && node scripts/category-alignment-check.js && node scripts/duplicate-upi-check.js",
    "test:catalogue-upload": "node scripts/catalogue-upload-check.js",
    "backfill:scan-categories": "node scripts/backfill-scan-categories.js",
    "start": "node scripts/railway-start.js"
  },
  "keywords": [
    "inventory",
    "audit",
    "postgresql",
    "prisma",
    "socket.io",
    "exceljs",
    "jspdf"
  ],
  "author": "Daksh Inventory",
  "license": "MIT",
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "3.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "prisma": "^6.16.3",
    "xlsx": "^0.18.5"
  }
}
