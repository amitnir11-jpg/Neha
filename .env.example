NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Set DAKSH_DEPLOY_TARGET=railway (or render) for a cloud deployment.
DAKSH_DEPLOY_TARGET=

# Connection policy. LOCAL advertises the PC as daksh.local and uses the
# configured LAN interface for discovery. CLOUD uses the configured public URL.
CONNECTION_MODE=LOCAL
APP_PORT=3000
MDNS_ENABLED=true
DAKSH_MDNS_HOSTNAME=daksh.local
DAKSH_MDNS_SERVICE_NAME=daksh-inventory
DAKSH_PAIRING_TTL_MINUTES=15
DAKSH_DATABASE_INIT_RETRY_MS=15000

# Railway service role:
# - api: backend API + Socket.IO
# - web: static frontend
DAKSH_SERVICE_ROLE=api

# Railway PostgreSQL injects this into the backend API service.
# The app also accepts DATABASE_PRIVATE_URL, DATABASE_PUBLIC_URL, POSTGRES_URL,
# POSTGRES_PRIVATE_URL, POSTGRES_PUBLIC_URL, POSTGRES_DATABASE_URL,
# POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, PGDATABASE_URL, PG_URL,
# PGURL, RAILWAY_DATABASE_URL, or PGHOST+PGPORT+PGUSER+PGPASSWORD+PGDATABASE.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=

# API service startup runs `prisma migrate deploy` before opening in production
# or Railway/Render. Set true only if you run migrations manually.
DAKSH_SKIP_MIGRATIONS=false

# Set on the web service to the backend API service HTTPS URL.
# Leave empty on the API service when frontend and API share one origin.
PUBLIC_API_BASE_URL=
DAKSH_ALLOWED_ORIGINS=

# Public URL for links and QR codes generated by the API service.
PUBLIC_BASE_URL=
MOBILE_DISCOVERY_PORT=3000

JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Master catalogue upload tuning
CATALOGUE_UPLOAD_MAX_MB=100
CATALOGUE_UPLOAD_CHUNK_SIZE=500
CATALOGUE_FAILURE_RETENTION_HOURS=24

# Optional email/OTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL=amitsvision4u@gmail.com

# Optional customer-build licensing.
# Keep false for local development. Set true in the Windows installer/customer build.
DAKSH_LICENSE_REQUIRED=false
DAKSH_LICENSE_APP_ID=daksh-inventory-v2
DAKSH_LICENSE_SERVER_URL=https://licenses.example.com
DAKSH_LICENSE_ACTIVATE_PATH=/api/licenses/activate
DAKSH_LICENSE_REVALIDATE_PATH=/api/licenses/revalidate
DAKSH_LICENSE_DEACTIVATE_PATH=/api/licenses/deactivate
DAKSH_LICENSE_PUBLIC_KEY_PATH=license-public.pem
DAKSH_LICENSE_REVALIDATE_HOURS=24
DAKSH_LICENSE_DPAPI_SCOPE=CurrentUser
